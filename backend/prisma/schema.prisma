// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// =============================================
// ENUMS
// =============================================

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
  HEAD
  OPTIONS
}

enum AssertionType {
  STATUS
  LATENCY
  JSON
}

enum AssertionOperator {
  EQ
  NEQ
  LT
  LTE
  GT
  GTE
  EXISTS
  NOT_EXISTS
}

enum NotificationType {
  OPENED
  RESOLVED
}

enum MonitorStatus {
  UNKNOWN
  UP
  DOWN
}

enum IncidentStatus {
  OPEN
  RESOLVED
}

// =============================================
// 1. USERS
// =============================================

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspaces    Workspace[]
  notifications Notification[]
  sessions      AuthSession[]

  @@map("users")
}

// =============================================
// 2. WORKSPACES
// =============================================

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  name      String   @db.VarChar(150)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projects Project[]

  @@index([ownerId])
  @@map("workspaces")
}

// =============================================
// 3. PROJECTS
// =============================================

model Project {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String   @db.VarChar(150)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  apiRequests ApiRequest[]

  @@index([workspaceId])
  @@map("projects")
}

// =============================================
// 4. API REQUESTS
// =============================================

model ApiRequest {
  id        String     @id @default(uuid()) @db.Uuid
  projectId String     @map("project_id") @db.Uuid
  name      String     @db.VarChar(150)
  method    HttpMethod @default(GET)
  url       String
  headers   Json?
  body      String?
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  project    Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assertions RequestAssertion[]
  executions RequestExecution[]
  monitors   Monitor[]

  @@index([projectId])
  @@map("api_requests")
}

// =============================================
// 5. REQUEST ASSERTIONS
// =============================================

model RequestAssertion {
  id            String            @id @default(uuid()) @db.Uuid
  requestId     String            @map("request_id") @db.Uuid
  type          AssertionType
  operator      AssertionOperator
  target        String?
  expectedValue Json?             @map("expected_value")
  isEnabled     Boolean           @default(true) @map("is_enabled")

  request ApiRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("request_assertions")
}

// =============================================
// 6. REQUEST EXECUTIONS
// Manual API Testing History
// =============================================

model RequestExecution {
  id               String   @id @default(uuid()) @db.Uuid
  requestId        String   @map("request_id") @db.Uuid
  statusCode       Int?     @map("status_code")
  responseTimeMs   Int?     @map("response_time_ms")
  isSuccess        Boolean  @map("is_success")
  responseBody     String?  @map("response_body")
  responseHeaders  Json?    @map("response_headers")
  assertionResults Json?    @map("assertion_results")
  errorMessage     String?  @map("error_message")
  executedAt       DateTime @default(now()) @map("executed_at") @db.Timestamptz(3)

  request ApiRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, executedAt])
  @@map("request_executions")
}

// =============================================
// 7. MONITORS
// =============================================

model Monitor {
  id                   String        @id @default(uuid()) @db.Uuid
  requestId            String        @map("request_id") @db.Uuid
  name                 String        @db.VarChar(150)
  intervalSeconds      Int           @default(300) @map("interval_seconds")
  timeoutMs            Int           @default(10000) @map("timeout_ms")
  failureThreshold     Int           @default(3) @map("failure_threshold")
  recoveryThreshold    Int           @default(2) @map("recovery_threshold")
  isEnabled            Boolean       @default(true) @map("is_enabled")
  status               MonitorStatus @default(UNKNOWN)
  consecutiveFailures  Int           @default(0) @map("consecutive_failures")
  consecutiveSuccesses Int           @default(0) @map("consecutive_successes")
  nextCheckAt          DateTime?     @map("next_check_at") @db.Timestamptz(3)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  request   ApiRequest     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  checks    MonitorCheck[]
  incidents Incident[]

  @@index([requestId])
  @@index([isEnabled, nextCheckAt])
  @@map("monitors")
}

// =============================================
// 8. MONITOR CHECKS
// Automatic Monitoring History
// =============================================

model MonitorCheck {
  id             String   @id @default(uuid()) @db.Uuid
  monitorId      String   @map("monitor_id") @db.Uuid
  statusCode     Int?     @map("status_code")
  responseTimeMs Int?     @map("response_time_ms")
  isSuccess      Boolean  @map("is_success")
  errorMessage   String?  @map("error_message")
  checkedAt      DateTime @default(now()) @map("checked_at") @db.Timestamptz(3)

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, checkedAt])
  @@map("monitor_checks")
}

// =============================================
// 9. INCIDENTS
// =============================================

model Incident {
  analyses IncidentAnalysis[]
  id         String         @id @default(uuid()) @db.Uuid
  monitorId  String         @map("monitor_id") @db.Uuid
  status     IncidentStatus @default(OPEN)
  reason     String?
  startedAt  DateTime       @default(now()) @map("started_at") @db.Timestamptz(3)
  resolvedAt DateTime?      @map("resolved_at") @db.Timestamptz(3)

  monitor       Monitor        @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@unique([monitorId], map: "incidents_one_open_per_monitor", where: { status: "OPEN" })
  @@index([monitorId, startedAt])
  @@map("incidents")
}

// =============================================
// 10. NOTIFICATIONS
// =============================================

model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  incidentId String           @map("incident_id") @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  type       NotificationType
  message    String
  isRead     Boolean          @default(false) @map("is_read")
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([incidentId])
  @@map("notifications")
}

model AuthSession {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([absoluteExpiresAt])
  @@map("auth_sessions")
}

// AI v3.0: saved diagnostic metadata only, never raw request secrets.
model IncidentAnalysis {
  id         String   @id @default(uuid()) @db.Uuid
  incidentId String   @map("incident_id") @db.Uuid
  model      String   @db.VarChar(100)
  diagnosis  Json
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  incident Incident @relation(fields:[incidentId],references:[id],onDelete:Cascade)
  @@index([incidentId,createdAt])
  @@map("incident_analyses")
}
